DATABASE_URL="postgresql://folio:folio_local@127.0.0.1:54329/folio?schema=public"
# Owner-configured reader URL. Remote readers require a private signed connection.
# Hosted end users do not need an API key; local installations use their own reader.
COMMAND_SYLLABUS_SERVICE_URL=""
# Hosted sign-in. Set these in Vercel, not in the downloaded app or a public variable.
NEON_AUTH_BASE_URL=""
# Optional owner override if the integration-managed Auth URL is locked or stuck provisioning.
COMMAND_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""
# Optional direct Neon URL for migrations. Runtime queries use DATABASE_URL.
DATABASE_URL_UNPOOLED=""
# Only needed to test hosted behavior outside Vercel. Vercel enables it automatically.
COMMAND_HOSTED="false"

# Hosted P0 release controls. Default closed; local edition remains account-free.
COMMAND_HOSTED_ACCESS=restricted
COMMAND_INVITED_WORKSPACES=
COMMAND_ALLOW_SIGNUP=false
COMMAND_GMAIL_RELEASE=disabled
COMMAND_GMAIL_TESTERS=
COMMAND_PUBLIC_OPERATOR=
COMMAND_PUBLIC_SUPPORT_EMAIL=
# See docs/p0-operations.md. No real budgets or model prices are assumed.
COMMAND_AI_USAGE_SECRET=
COMMAND_AI_DAILY_MICROS=
COMMAND_AI_MONTHLY_MICROS=
COMMAND_AI_CHAT_DAILY=
COMMAND_AI_CHAT_MONTHLY=
COMMAND_AI_SYLLABUS_DAILY=
COMMAND_AI_SYLLABUS_MONTHLY=
COMMAND_AI_CONCURRENCY=
COMMAND_AI_MODELS_JSON={}
COMMAND_SYLLABUS_MODELS=
COMMAND_READER_SIGNING_SECRET=
